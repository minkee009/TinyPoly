{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/src"
            ],
            "compilerPath": "${env:USERPROFILE}/scoop/apps/mingw/current/bin/gcc.exe",
            "cStandard": "c23",
            "compileCommands": "${workspaceFolder}/build/Windows/compile_commands.json",
            "intelliSenseMode": "windows-gcc-x64"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/src",
                "/usr/include"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c23",
            "compileCommands": "${workspaceFolder}/build/Linux/compile_commands.json",
            "intelliSenseMode": "linux-clang-x64"
        },
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/src",
                "/opt/homebrew/include"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c23",
            "compileCommands": "${workspaceFolder}/build/Darwin/compile_commands.json",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}
